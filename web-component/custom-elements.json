            { "name": "minor-tick-step", "type": { "text": "number" }, "description": "Interval between optional unlabeled minor ticks." },
            { "name": "show-tick-labels", "type": { "text": "boolean" }, "default": "false", "description": "Displays labels below major ticks." },
            { "name": "disable-balloon-rotation", "type": { "text": "boolean" }, "default": "false", "description": "Disables velocity-based balloon rotation while dragging." },
