            { "name": "mode", "type": { "text": "'single' | 'range'" }, "default": "'single'", "description": "Selects one value or a start/end pair." },
            { "name": "start-point", "type": { "text": "number" }, "description": "Start of the active line in single mode; defaults like the single-mode value." },
            { "name": "min", "type": { "text": "number" }, "default": "0", "description": "Minimum selectable value." },
            { "name": "max", "type": { "text": "number" }, "default": "10", "description": "Maximum selectable value." },
            { "name": "step", "type": { "text": "number" }, "default": "1", "description": "Selectable and keyboard increment." },
